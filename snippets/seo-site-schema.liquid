{%- doc -%}
  Site-wide JSON-LD: one WebSite node, one Organization/Brand node, and a
  BreadcrumbList on product, collection, page, blog and article pages.

  This is the ONLY place Organization schema should be output. Product schema is
  rendered by sections/product-information.liquid via Shopify's `structured_data`
  filter (Product + Offer with price, currency and availability), and Judge.me adds
  review data through its app embed — so neither is duplicated here.

  All dynamic values go through the `json` filter, which escapes quotes, slashes
  and HTML so merchant-entered text can't break the script block.

  Social profiles come from Theme settings → SEO & seasonal copy → "Social profile URLs".

  @example
  {% render 'seo-site-schema' %}
{%- enddoc -%}

{%- liquid
  assign site_url = shop.url | append: '/'
  assign org_id = shop.url | append: '/#organization'
  assign website_id = shop.url | append: '/#website'
  assign search_target = shop.url | append: '/search?q={search_term_string}'

  if settings.logo != blank
    assign org_logo = settings.logo | image_url: width: 600 | prepend: 'https:'
  else
    assign org_logo = 'logo.png' | file_url | prepend: 'https:'
  endif

  assign same_as_lines = settings.seo_same_as | newline_to_br | split: '<br />'
  assign same_as = ''
  for line in same_as_lines
    assign url = line | strip
    if url contains 'https://'
      assign same_as = same_as | append: ',' | append: url
    endif
  endfor
  assign same_as = same_as | remove_first: ',' | split: ','

  # strip_html leaves entities like "&amp;"; decode so JSON-LD carries a plain "&".
  assign org_description_html = shop.description | strip_html | strip
  capture org_description
    render 'decode-entities', text: org_description_html
  endcapture

  # ---- Breadcrumbs (Home › parent › current page) for Google's result trail.
  # Product pages use the collection they were opened from, otherwise their first
  # real collection. The last item is always the page's canonical URL.
  assign crumb_parent_name = ''
  assign crumb_parent_url = ''
  assign crumb_current_name = ''

  case request.page_type
    when 'product'
      assign crumb_current_name = product.title
      assign crumb_collection = collection
      if crumb_collection == blank
        for product_collection in product.collections
          unless product_collection.handle == 'frontpage' or product_collection.handle == 'all'
            assign crumb_collection = product_collection
            break
          endunless
        endfor
      endif
      if crumb_collection != blank
        assign crumb_parent_name = crumb_collection.title
        assign crumb_parent_url = shop.url | append: crumb_collection.url
      endif
    when 'collection'
      assign crumb_current_name = collection.title
    when 'page'
      assign crumb_current_name = page.title
    when 'blog'
      assign crumb_current_name = blog.title
    when 'article'
      assign crumb_current_name = article.title
      assign crumb_parent_name = blog.title
      assign crumb_parent_url = shop.url | append: blog.url
  endcase
-%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": {{ website_id | json }},
        "url": {{ site_url | json }},
        "name": {{ shop.name | json }},
        "inLanguage": {{ request.locale.iso_code | json }},
        "publisher": { "@id": {{ org_id | json }} },
        "potentialAction": {
          "@type": "SearchAction",
          "target": {{ search_target | json }},
          "query-input": "required name=search_term_string"
        }
      },
      {
        "@type": "Organization",
        "@id": {{ org_id | json }},
        "name": {{ shop.name | json }},
        "url": {{ site_url | json }},
        "logo": {{ org_logo | json }},
        {%- if org_description != blank %}
          "description": {{ org_description | json }},
        {%- endif %}
        {%- if same_as.size > 0 %}
          "sameAs": {{ same_as | json }},
        {%- endif %}
        "brand": {
          "@type": "Brand",
          "name": {{ shop.name | json }},
          "logo": {{ org_logo | json }}
        }
      }
      {%- if crumb_current_name != blank %},
      {
        "@type": "BreadcrumbList",
        "@id": {{ canonical_url | append: '#breadcrumb' | json }},
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": {{ site_url | json }}
          },
          {%- if crumb_parent_name != blank %}
          {
            "@type": "ListItem",
            "position": 2,
            "name": {{ crumb_parent_name | json }},
            "item": {{ crumb_parent_url | json }}
          },
          {%- endif %}
          {
            "@type": "ListItem",
            "position": {% if crumb_parent_name != blank %}3{% else %}2{% endif %},
            "name": {{ crumb_current_name | json }},
            "item": {{ canonical_url | json }}
          }
        ]
      }
      {%- endif %}
    ]
  }
</script>
