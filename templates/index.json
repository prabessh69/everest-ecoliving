{
  "sections": {
    "custom_liquid_yCgaUp": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<div class=\"everest-hero-slider\" id=\"everestHeroSlider\">\n  \n  <!-- SLIDE 1 -->\n  <div class=\"everest-slide active-slide\">\n    <img src=\"{{ 'landing_image_1.jpg' | file_url }}\" class=\"everest-slide-bg slide-1-focus\" alt=\"Fair Trade\">\n    <div class=\"everest-slide-overlay\"></div>\n    <div class=\"everest-content-box\">\n      <h2 class=\"everest-slide-title\">Fair Trade</h2>\n      <p class=\"everest-slide-text\">Empowering women artisans through safe working environments and dignified living wages. Your purchase directly supports sustainable livelihoods and vibrant local communities.</p>\n      <a href=\"/collections/all\" class=\"everest-slide-btn\">Explore Collection</a>\n    </div>\n  </div>\n\n  <!-- SLIDE 2 -->\n  <div class=\"everest-slide\">\n    <img src=\"{{ '11I0896.jpg' | file_url }}\" class=\"everest-slide-bg\" alt=\"Ethical And Eco-Friendly\">\n    <div class=\"everest-slide-overlay\"></div>\n    <div class=\"everest-content-box\">\n      <h2 class=\"everest-slide-title\">Ethical & Eco-Friendly</h2>\n      <p class=\"everest-slide-text\">Crafted with zero-waste principles using pure, non-toxic wool. Sustainable, earth-friendly goods designed to bring timeless warmth and beauty to your home.</p>\n      <a href=\"/collections/all\" class=\"everest-slide-btn\">Explore Collection</a>\n    </div>\n  </div>\n\n  <!-- SLIDE 3 -->\n  <div class=\"everest-slide\">\n    <img src=\"{{ 'landing_image_4.jpg' | file_url }}\" class=\"everest-slide-bg\" alt=\"Handmade\">\n    <div class=\"everest-slide-overlay\"></div>\n    <div class=\"everest-content-box\">\n      <h2 class=\"everest-slide-title\">Handmade</h2>\n      <p class=\"everest-slide-text\">Lovingly wet-felted by skilled women artisans in Nepal using 100% natural, premium New Zealand wool. Every piece carries the warmth and character of genuine craftsmanship.</p>\n      <a href=\"/collections/all\" class=\"everest-slide-btn\">Explore Collection</a>\n    </div>\n  </div>\n\n  <!-- NAVIGATION CONTROLS -->\n  <button class=\"everest-nav-btn prev-btn\" onclick=\"moveEverestSlide(-1)\">&#10094;</button>\n  <button class=\"everest-nav-btn next-btn\" onclick=\"moveEverestSlide(1)\">&#10095;</button>\n\n  <div class=\"everest-dots-container\">\n    <span class=\"everest-dot active-dot\" onclick=\"setEverestSlide(0)\"></span>\n    <span class=\"everest-dot\" onclick=\"setEverestSlide(1)\"></span>\n    <span class=\"everest-dot\" onclick=\"setEverestSlide(2)\"></span>\n  </div>\n\n</div>\n\n<style>\n  /* Slider Container */\n  .everest-hero-slider {\n    position: relative;\n    width: 100vw;\n    height: 80vh; \n    min-height: 550px;\n    left: 50%;\n    right: 50%;\n    margin-left: -50vw;\n    margin-right: -50vw;\n    overflow: hidden;\n    background-color: #111; \n    display: flex;\n    align-items: center;\n  }\n\n  /* Individual Slides */\n  .everest-slide {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    opacity: 0;\n    visibility: hidden;\n    transition: opacity 1s ease-in-out, visibility 1s ease-in-out;\n    z-index: 1;\n  }\n\n  .everest-slide.active-slide {\n    opacity: 1;\n    visibility: visible;\n    z-index: 2;\n  }\n\n  /* Background Image */\n  .everest-slide-bg {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: center;\n    transform: scale(1.05);\n    transition: transform 7s ease-out;\n  }\n  \n  .everest-slide.active-slide .everest-slide-bg {\n    transform: scale(1);\n  }\n\n  /* Cinematic Gradient Overlay */\n  .everest-slide-overlay {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    background: linear-gradient(90deg, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.4) 40%, rgba(0,0,0,0) 100%);\n    pointer-events: none;\n  }\n\n  /* Content Box */\n  .everest-content-box {\n    position: absolute;\n    top: 50%;\n    left: 8%;\n    transform: translateY(-50%);\n    width: 90%;\n    max-width: 550px;\n    padding: 20px 0;\n    text-align: left;\n  }\n\n  /* Typography */\n  .everest-slide-title {\n    font-family: 'Playfair Display', serif, Georgia;\n    font-size: 46px;\n    font-weight: 700;\n    color: #FFFFFF;\n    margin: 0 0 16px 0;\n    line-height: 1.1;\n    letter-spacing: 0.5px;\n    text-shadow: 0 2px 4px rgba(0,0,0,0.3);\n  }\n\n  .everest-slide-text {\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n    font-size: 16px;\n    color: #F4F4F4;\n    line-height: 1.6;\n    margin: 0 0 30px 0;\n    text-shadow: 0 1px 3px rgba(0,0,0,0.4);\n  }\n\n  /* Call to Action Button */\n  .everest-slide-btn {\n    display: inline-block;\n    padding: 15px 32px;\n    background: #FFFFFF;\n    color: #111111;\n    font-size: 13px;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 1.5px;\n    text-decoration: none;\n    border-radius: 4px;\n    transition: background 0.3s ease, transform 0.2s ease, box-shadow 0.3s ease;\n  }\n\n  .everest-slide-btn:hover {\n    background: #F0F0F0;\n    transform: translateY(-2px);\n    box-shadow: 0 8px 15px rgba(0,0,0,0.2);\n    color: #111111;\n  }\n\n  /* Navigation Arrows */\n  .everest-nav-btn {\n    position: absolute;\n    top: 50%;\n    transform: translateY(-50%);\n    background: rgba(255, 255, 255, 0.15);\n    color: #FFF;\n    border: 1px solid rgba(255, 255, 255, 0.3);\n    width: 50px;\n    height: 50px;\n    border-radius: 50%;\n    font-size: 20px;\n    cursor: pointer;\n    z-index: 10;\n    transition: background 0.3s ease, border 0.3s ease;\n    backdrop-filter: blur(5px);\n  }\n\n  .everest-nav-btn:hover {\n    background: rgba(255, 255, 255, 0.3);\n    border-color: #FFF;\n  }\n\n  .prev-btn { left: 20px; }\n  .next-btn { right: 20px; }\n\n  /* Navigation Dots */\n  .everest-dots-container {\n    position: absolute;\n    bottom: 30px;\n    left: 50%;\n    transform: translateX(-50%);\n    z-index: 10;\n    display: flex;\n    gap: 12px;\n  }\n\n  .everest-dot {\n    width: 10px;\n    height: 10px;\n    border-radius: 50%;\n    background: rgba(255, 255, 255, 0.4);\n    cursor: pointer;\n    transition: all 0.3s ease;\n  }\n\n  .everest-dot.active-dot {\n    background: #FFFFFF;\n    transform: scale(1.3);\n  }\n\n  /* =========================================\n     MOBILE ADJUSTMENTS (OPTIMIZED PROPORTIONS)\n     ========================================= */\n  @media (max-width: 768px) {\n    .everest-hero-slider {\n      height: 55vh; /* Dramatically reduced height to show more image width */\n      min-height: 420px; \n    }\n    \n    /* Shift the focal point of the first image to capture the artisans */\n    .slide-1-focus {\n      object-position: 35% center;\n    }\n    \n    .everest-slide-overlay {\n      background: linear-gradient(0deg, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.4) 60%, rgba(0,0,0,0) 100%);\n    }\n\n    .everest-content-box {\n      top: auto;\n      bottom: 10%; \n      left: 5%;\n      width: 90%;\n      text-align: center;\n      padding: 0 10px; \n    }\n    \n    .everest-slide-title {\n      font-size: 28px; /* Scaled down */\n      margin-bottom: 10px;\n    }\n    \n    .everest-slide-text {\n      font-size: 13px; /* Scaled down */\n      line-height: 1.45;\n      margin-bottom: 18px;\n    }\n\n    .everest-slide-btn {\n      padding: 12px 26px;\n      font-size: 11.5px;\n    }\n    \n    .everest-nav-btn {\n      display: block !important; \n      width: 36px;\n      height: 36px;\n      font-size: 14px;\n      background: rgba(255, 255, 255, 0.2); \n    }\n    \n    .prev-btn { left: 8px; }\n    .next-btn { right: 8px; }\n\n    .everest-dots-container {\n      bottom: 15px;\n      gap: 10px;\n    }\n  }\n</style>\n\n<script>\n  let everestCurrentSlideIndex = 0;\n  let everestSlideInterval;\n  const slideDelay = 6000; \n\n  function showEverestSlide(index) {\n    const slides = document.querySelectorAll('.everest-slide');\n    const dots = document.querySelectorAll('.everest-dot');\n    \n    if (slides.length === 0) return;\n\n    if (index >= slides.length) everestCurrentSlideIndex = 0;\n    if (index < 0) everestCurrentSlideIndex = slides.length - 1;\n\n    slides.forEach(slide => slide.classList.remove('active-slide'));\n    dots.forEach(dot => dot.classList.remove('active-dot'));\n\n    slides[everestCurrentSlideIndex].classList.add('active-slide');\n    dots[everestCurrentSlideIndex].classList.add('active-dot');\n  }\n\n  function moveEverestSlide(step) {\n    everestCurrentSlideIndex += step;\n    showEverestSlide(everestCurrentSlideIndex);\n    resetEverestInterval();\n  }\n\n  function setEverestSlide(index) {\n    everestCurrentSlideIndex = index;\n    showEverestSlide(everestCurrentSlideIndex);\n    resetEverestInterval();\n  }\n\n  function startEverestInterval() {\n    everestSlideInterval = setInterval(() => {\n      moveEverestSlide(1);\n    }, slideDelay);\n  }\n\n  function resetEverestInterval() {\n    clearInterval(everestSlideInterval);\n    startEverestInterval();\n  }\n\n  document.addEventListener('DOMContentLoaded', () => {\n    showEverestSlide(everestCurrentSlideIndex);\n    startEverestInterval();\n  });\n\n  if (document.readyState === 'complete' || document.readyState === 'interactive') {\n    showEverestSlide(everestCurrentSlideIndex);\n    startEverestInterval();\n  }\n  document.addEventListener('shopify:section:load', () => {\n    showEverestSlide(everestCurrentSlideIndex);\n    resetEverestInterval();\n  });\n</script>",
