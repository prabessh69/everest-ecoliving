    "custom_liquid_GPYg7Y": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<style>\n  /* 1. Base hidden state (Forced with !important so Shopify can't override it) */\n  .custom-pop-card {\n    opacity: 0 !important;\n    transform: translateY(40px) scale(0.9) !important;\n    transition: opacity 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275), \n                transform 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;\n  }\n\n  /* 2. Active state when scrolled into view */\n  .custom-pop-card.is-visible {\n    opacity: 1 !important;\n    transform: translateY(0) scale(1) !important;\n  }\n\n  /* 3. Hover pop */\n  .custom-pop-card.is-visible:hover {\n    transform: translateY(-6px) scale(1.02) !important;\n    transition-delay: 0s !important;\n  }\n</style>\n\n<script>\n  (function() {\n    function initCollectionScrollAnim() {\n      // Find the invisible links you shared\n      const links = document.querySelectorAll('.collection-card__link');\n      if (links.length === 0) return;\n\n      const targetCards = [];\n\n      // Step out to the main visible grid box\n      links.forEach(link => {\n        const cardBox = link.closest('.collection-list__item, li, .card-wrapper');\n        \n        if (cardBox && !cardBox.classList.contains('custom-pop-card')) {\n          cardBox.classList.add('custom-pop-card');\n          targetCards.push(cardBox);\n        }\n      });\n\n      const cardObserver = new IntersectionObserver((entries) => {\n        entries.forEach(entry => {\n          if (entry.isIntersecting) {\n            entry.target.classList.add('is-visible');\n          } else {\n            entry.target.classList.remove('is-visible');\n          }\n        });\n      }, { root: null, rootMargin: '0px 0px -5% 0px', threshold: 0.1 });\n\n      targetCards.forEach(card => cardObserver.observe(card));\n    }\n\n    // Run immediately and safely hook into Shopify's loading events\n    initCollectionScrollAnim();\n    document.addEventListener('DOMContentLoaded', initCollectionScrollAnim);\n    document.addEventListener('shopify:section:load', initCollectionScrollAnim);\n    setTimeout(initCollectionScrollAnim, 500); // Backup delay\n  })();\n</script>",
        "background_color": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "custom_liquid_XHhy8T": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<style>\n  /* 1. Base hidden state locked with !important */\n  .custom-pop-bestseller-card {\n    opacity: 0 !important;\n    transform: translateY(40px) scale(0.9) !important;\n    transition: opacity 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275), \n                transform 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;\n  }\n\n  /* 2. Active state triggered on scroll */\n  .custom-pop-bestseller-card.is-visible {\n    opacity: 1 !important;\n    transform: translateY(0) scale(1) !important;\n  }\n\n  /* 3. Hover pop */\n  .custom-pop-bestseller-card.is-visible:hover {\n    transform: translateY(-6px) scale(1.02) !important;\n    transition-delay: 0s !important;\n  }\n</style>\n\n<script>\n  (function() {\n    function initBestSellerScrollAnim() {\n      // 1. Target the specific product-price element from your snippet\n      const priceElements = document.querySelectorAll('product-price');\n      if (priceElements.length === 0) return;\n\n      const targetCards = [];\n\n      // 2. Step backwards to grab the whole 'group-block' card holding the Yak and price\n      priceElements.forEach(price => {\n        const cardBox = price.closest('.group-block');\n        \n        if (cardBox && !cardBox.classList.contains('custom-pop-bestseller-card')) {\n          cardBox.classList.add('custom-pop-bestseller-card');\n          targetCards.push(cardBox);\n        }\n      });\n\n      // 3. Set up the observer\n      const observerOptions = {\n        root: null,\n        rootMargin: '0px 0px -5% 0px', \n        threshold: 0.1\n      };\n\n      const cardObserver = new IntersectionObserver((entries) => {\n        entries.forEach(entry => {\n          if (entry.isIntersecting) {\n            entry.target.classList.add('is-visible');\n          } else {\n            entry.target.classList.remove('is-visible');\n          }\n        });\n      }, observerOptions);\n\n      // 4. Trigger the animation\n      targetCards.forEach(card => cardObserver.observe(card));\n    }\n\n    // Run the script and hook into Shopify events\n    initBestSellerScrollAnim();\n    document.addEventListener('DOMContentLoaded', initBestSellerScrollAnim);\n    document.addEventListener('shopify:section:load', initBestSellerScrollAnim);\n    setTimeout(initBestSellerScrollAnim, 500);\n  })();\n</script>",
        "background_color": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
