    "custom_liquid_BkWzG7": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<div class=\"why-us-wrapper-star\" id=\"why-us-custom-block\">\n  <div class=\"why-us-container-inner\">\n    <div class=\"why-us-header\">\n      <h2 class=\"why-us-title\">Why Choose Us</h2>\n      <p class=\"why-us-subtitle\">Handcrafted with love, powered by purpose.</p>\n    </div>\n\n    <div class=\"why-us-star-grid\">\n      <!-- Top Left Card -->\n      <div class=\"why-us-card-star pos-tl\">\n        <div class=\"why-us-icon-star\">\n          <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z\"></path><path d=\"M12 8v4l3 3\"></path></svg>\n        </div>\n        <div class=\"why-us-content-star\">\n          <h3 class=\"card-title-star\">AUTHENTIC ARTISTRY</h3>\n          <p class=\"card-desc-star\">100% handcrafted wet-felted designs made with care, precision, and centuries-old Nepali skill.</p>\n        </div>\n      </div>\n\n      <!-- Top Right Card -->\n      <div class=\"why-us-card-star pos-tr\">\n        <div class=\"why-us-icon-star\">\n          <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"></path></svg>\n        </div>\n        <div class=\"why-us-content-star\">\n          <h3 class=\"card-title-star\">100% WOMEN EMPOWERED</h3>\n          <p class=\"card-desc-star\">Supporting local female artisans in Nepal with safe working conditions, community, and living wages.</p>\n        </div>\n      </div>\n\n      <!-- CENTER HUB CARD: Ethical & Fair Trade -->\n      <div class=\"why-us-card-star pos-center\">\n        <div class=\"why-us-icon-star icon-center\">\n          <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path><path d=\"M9 12l2 2 4-4\"></path></svg>\n        </div>\n        <div class=\"why-us-content-star\">\n          <h3 class=\"card-title-star\">ETHICAL & FAIR TRADE</h3>\n          <p class=\"card-desc-star\">Committed to direct, transparent artisan partnerships with equitable compensation at every stage.</p>\n        </div>\n      </div>\n\n      <!-- Bottom Left Card -->\n      <div class=\"why-us-card-star pos-bl\">\n        <div class=\"why-us-icon-star\">\n          <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path></svg>\n        </div>\n        <div class=\"why-us-content-star\">\n          <h3 class=\"card-title-star\">SUSTAINABLE LIVING</h3>\n          <p class=\"card-desc-star\">Zero-waste, eco-conscious, non-toxic felted products crafted to bring timeless sustainability home.</p>\n        </div>\n      </div>\n\n      <!-- Bottom Right Card -->\n      <div class=\"why-us-card-star pos-br\">\n        <div class=\"why-us-icon-star\">\n          <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n        </div>\n        <div class=\"why-us-content-star\">\n          <h3 class=\"card-title-star\">PREMIUM MATERIALS</h3>\n          <p class=\"card-desc-star\">Made exclusively from pure, high-grade New Zealand wool—naturally hypoallergenic, soft, and durable.</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n  /* Slim, full-width section container */\n  .why-us-wrapper-star {\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    right: 50%;\n    margin-left: -50vw;\n    margin-right: -50vw;\n    background: linear-gradient(180deg, #FAF0F8 0%, #F3DDF3 100%);\n    padding: 45px 20px;\n    box-sizing: border-box;\n    overflow: hidden; /* Prevents animation from causing horizontal scroll */\n  }\n\n  .why-us-container-inner {\n    max-width: 1050px;\n    margin: 0 auto;\n  }\n\n  .why-us-header {\n    text-align: center;\n    margin-bottom: 30px;\n  }\n\n  .why-us-title {\n    font-family: 'Playfair Display', serif, Georgia;\n    font-size: 32px;\n    font-weight: 700;\n    color: #111111;\n    margin: 0 0 8px 0;\n    letter-spacing: 0.5px;\n  }\n\n  .why-us-subtitle {\n    font-size: 15px;\n    color: #555555;\n    margin: 0;\n  }\n\n  /* Star Grid */\n  .why-us-star-grid {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 16px;\n    align-items: center;\n  }\n\n  /* \n   * ANIMATION BASE STATE (Hidden & Scaled Down) \n   * Transition is disabled here so it doesn't animate on page load before scrolling \n   */\n  .why-us-card-star {\n    background: #FFFFFF;\n    border: 1.5px solid #111111;\n    border-radius: 12px;\n    padding: 16px 20px;\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    box-shadow: 0px 3px 8px rgba(0, 0, 0, 0.03);\n    box-sizing: border-box;\n    \n    /* Animation hidden states */\n    opacity: 0;\n    transform: translateY(30px) scale(0.95);\n    transition: opacity 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275), \n                transform 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275), \n                box-shadow 0.2s ease, \n                border-color 0.2s ease;\n  }\n\n  /* \n   * ANIMATION ACTIVE STATE (Triggered by JS when scrolled into view)\n   */\n  .why-us-card-star.is-visible {\n    opacity: 1;\n    transform: translateY(0) scale(1);\n  }\n\n  /* Staggered delays so they pop in one by one */\n  .why-us-card-star.pos-tl.is-visible { transition-delay: 0.1s; }\n  .why-us-card-star.pos-tr.is-visible { transition-delay: 0.2s; }\n  .why-us-card-star.pos-center.is-visible { transition-delay: 0.3s; }\n  .why-us-card-star.pos-bl.is-visible { transition-delay: 0.4s; }\n  .why-us-card-star.pos-br.is-visible { transition-delay: 0.5s; }\n\n  /* \n   * HOVER STATE (Only applies after it's visible, overrides transition delay so it's instant)\n   */\n  .why-us-card-star.is-visible:hover {\n    transform: translateY(-4px) scale(1.02);\n    box-shadow: 0px 8px 20px rgba(0, 0, 0, 0.1);\n    transition-delay: 0s !important; /* Forces hover to be instant */\n  }\n\n  /* CENTER HUB CARD */\n  .why-us-card-star.pos-center {\n    grid-column: span 2;\n    max-width: 560px;\n    margin: 6px auto;\n    border: 2px solid #111111;\n    background: #FFFFFF;\n    box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.06);\n  }\n\n  .why-us-icon-star {\n    width: 44px;\n    height: 44px;\n    min-width: 44px;\n    background: #FAF0F8;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: #222222;\n  }\n\n  .why-us-icon-star.icon-center {\n    background: #FAF0F8;\n    color: #111111;\n  }\n\n  .why-us-content-star {\n    text-align: left;\n  }\n\n  .card-title-star {\n    font-size: 14px;\n    font-weight: 800;\n    color: #111111;\n    margin: 0 0 4px 0;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n    line-height: 1.2;\n  }\n\n  .card-desc-star {\n    font-size: 13px;\n    color: #444444;\n    line-height: 1.4;\n    margin: 0;\n  }\n\n  /* Mobile responsiveness */\n  @media (max-width: 768px) {\n    .why-us-wrapper-star {\n      padding: 35px 16px;\n    }\n    .why-us-title {\n      font-size: 26px;\n    }\n    .why-us-star-grid {\n      grid-template-columns: 1fr;\n      gap: 12px;\n    }\n    .why-us-card-star.pos-center {\n      grid-column: span 1;\n      width: 100%;\n      max-width: 100%;\n    }\n    .why-us-card-star {\n      padding: 14px 16px;\n    }\n    \n    /* Slightly faster stagger on mobile so the user doesn't scroll past them */\n    .why-us-card-star.pos-tl.is-visible { transition-delay: 0.05s; }\n    .why-us-card-star.pos-tr.is-visible { transition-delay: 0.1s; }\n    .why-us-card-star.pos-center.is-visible { transition-delay: 0.15s; }\n    .why-us-card-star.pos-bl.is-visible { transition-delay: 0.2s; }\n    .why-us-card-star.pos-br.is-visible { transition-delay: 0.25s; }\n  }\n</style>\n\n<script>\n  (function() {\n    function initWhyUsScrollAnim() {\n      const cards = document.querySelectorAll('#why-us-custom-block .why-us-card-star');\n      if (cards.length === 0) return;\n\n      const observerOptions = {\n        root: null,\n        rootMargin: '0px 0px -10% 0px',\n        threshold: 0.1\n      };\n\n      const cardObserver = new IntersectionObserver((entries) => {\n        entries.forEach(entry => {\n          if (entry.isIntersecting) {\n            // Card enters the screen: trigger animation\n            entry.target.classList.add('is-visible');\n          } else {\n            // Card leaves the screen: reset animation\n            entry.target.classList.remove('is-visible');\n          }\n        });\n      }, observerOptions);\n\n      cards.forEach(card => cardObserver.observe(card));\n    }\n\n    // Run on load, and re-initialize if Customizer updates without reload\n    document.addEventListener('DOMContentLoaded', initWhyUsScrollAnim);\n    document.addEventListener('shopify:section:load', initWhyUsScrollAnim);\n    \n    // Immediate fallback invocation for quick render\n    if (document.readyState === 'interactive' || document.readyState === 'complete') {\n      initWhyUsScrollAnim();\n    }\n  })();\n</script>",
