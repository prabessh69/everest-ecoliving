    "custom_liquid_NknyF6": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "{% assign current_title = collection.title | downcase %}\n{% assign current_handle = collection.handle | downcase %}\n\n{% comment %} Show Coming Soon ONLY if it is NOT festive AND has no active products listed {% endcomment %}\n{% unless current_title contains 'festive' or current_handle contains 'home-eco-living' or current_handle contains 'festive' or collection.all_products_count > 0 %}\n\n  <div class=\"coming-soon-card-wrapper\">\n    <div class=\"coming-soon-card-container\">\n      \n      <!-- Decorative Icon Badge -->\n      <div class=\"coming-soon-badge\">\n        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#C05A67\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n          <polyline points=\"12 6 12 12 16 14\"></polyline>\n        </svg>\n      </div>\n\n      <span class=\"coming-soon-tagline\">Handcrafted Heritage In Production</span>\n      \n      <h2 class=\"coming-soon-title\">\n        {{ collection.title | default: \"Artisanal Collection\" }} — Coming Soon\n      </h2>\n\n      <p class=\"coming-soon-description\">\n        Our master women artisans in Kathmandu are currently hand-felting this new collection using 100% pure New Zealand wool and non-toxic Azo-free dyes. Stay tuned as we prepare these zero-waste creations for launch!\n      </p>\n\n      <!-- Sub-Pillars -->\n      <div class=\"coming-soon-highlights\">\n        <span class=\"highlight-chip\">❀ 100% Pure NZ Wool</span>\n        <span class=\"highlight-chip\">❀ Fair Trade Empowered</span>\n        <span class=\"highlight-chip\">❀ Zero-Waste & Natural</span>\n      </div>\n\n      <!-- Button pointing directly to live collection -->\n      <div class=\"coming-soon-actions\">\n        <a href=\"/collections/home-eco-living\" class=\"primary-btn\">\n          Explore Available Festive Ornaments\n        </a>\n      </div>\n\n    </div>\n  </div>\n\n  <style>\n    .coming-soon-card-wrapper {\n      width: 100%;\n      padding: 30px 0 40px 0;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      box-sizing: border-box;\n    }\n\n    .coming-soon-card-container {\n      max-width: 680px;\n      width: 100%;\n      background: #FFFFFF;\n      border: 1.5px solid #F2D6D3;\n      border-radius: 22px;\n      padding: 44px 32px;\n      text-align: center;\n      box-shadow: 0 8px 24px rgba(217, 136, 128, 0.08);\n      box-sizing: border-box;\n      margin: 0 auto;\n    }\n\n    .coming-soon-badge {\n      width: 52px;\n      height: 52px;\n      background-color: #FAF0F8;\n      border: 1px solid #F2D6D3;\n      border-radius: 50%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      margin: 0 auto 16px;\n    }\n\n    .coming-soon-tagline {\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n      font-size: 11px;\n      font-weight: 700;\n      text-transform: uppercase;\n      letter-spacing: 2px;\n      color: #D98880;\n      display: block;\n      margin-bottom: 8px;\n    }\n\n    .coming-soon-title {\n      font-family: \"Playfair Display\", Georgia, serif;\n      font-size: 32px;\n      font-weight: 700;\n      color: #111111;\n      margin: 0 0 14px 0;\n      line-height: 1.2;\n    }\n\n    .coming-soon-description {\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n      font-size: 14px;\n      line-height: 1.65;\n      color: #555555;\n      margin: 0 0 22px 0;\n    }\n\n    .coming-soon-highlights {\n      display: flex;\n      flex-wrap: wrap;\n      justify-content: center;\n      gap: 10px;\n      margin-bottom: 28px;\n    }\n\n    .highlight-chip {\n      background: #FAF0F8;\n      color: #C05A67;\n      border: 1px solid #F2D6D3;\n      padding: 6px 14px;\n      border-radius: 20px;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n      font-size: 12px;\n      font-weight: 600;\n    }\n\n    .coming-soon-actions {\n      display: flex;\n      justify-content: center;\n    }\n\n    .primary-btn {\n      display: inline-block;\n      background-color: #C05A67;\n      color: #FFFFFF !important;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n      font-size: 13.5px;\n      font-weight: 700;\n      padding: 13px 26px;\n      border-radius: 30px;\n      text-decoration: none;\n      transition: background-color 0.25s ease, transform 0.25s ease;\n      box-shadow: 0 4px 14px rgba(192, 90, 103, 0.2);\n    }\n\n    .primary-btn:hover {\n      background-color: #A0404C;\n      transform: translateY(-2px);\n    }\n\n    @media (max-width: 768px) {\n      .coming-soon-card-wrapper {\n        padding: 15px 0 25px 0;\n      }\n\n      .coming-soon-card-container {\n        padding: 28px 18px;\n        border-radius: 16px;\n      }\n\n      .coming-soon-title {\n        font-size: 24px;\n      }\n\n      .coming-soon-description {\n        font-size: 13px;\n      }\n    }\n  </style>\n\n{% endunless %}",
