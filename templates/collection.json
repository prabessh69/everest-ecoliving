    "custom_liquid_4AMGn6": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "{% assign current_handle = collection.handle %}\n\n{% case current_handle %}\n  {% when 'felt-festive-decorations', 'festive', 'festive-decorations', 'home-eco-living' %}\n    {% assign badge_text = \"Handcrafted Holiday\" %}\n\n  {% when 'felt-home-wares', 'homewares', 'home-wares' %}\n    {% assign badge_text = \"Cozy & Artisanal\" %}\n\n  {% when 'felt-bags-and-purses', 'bags-and-purses', 'bags' %}\n    {% assign badge_text = \"Ethical Accessories\" %}\n\n  {% when 'felt-pet-play', 'pet-play', 'pets' %}\n    {% assign badge_text = \"Eco-Friendly Pet Living\" %}\n\n  {% else %}\n    {% assign badge_text = \"Artisanal Creations\" %}\n{% endcase %}\n\n<div class=\"custom-collection-banner-wrapper\">\n  <div class=\"custom-collection-banner-container\">\n    <span class=\"banner-badge\">{{ badge_text }}</span>\n    <h1 class=\"collection-main-title\">\n      {{ collection.title | default: \"Felt Festive Decorations\" }}\n    </h1>\n  </div>\n</div>\n\n<style>\n  .custom-collection-banner-wrapper {\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    right: 50%;\n    margin-left: -50vw;\n    margin-right: -50vw;\n    background: #FAF0F8;\n    padding: 24px 20px;\n    box-sizing: border-box;\n    border-bottom: 1px solid #F2D6D3;\n  }\n\n  .custom-collection-banner-container {\n    max-width: 1200px;\n    margin: 0 auto;\n    display: flex;\n    flex-direction: column;\n    align-items: flex-start;\n    justify-content: center;\n  }\n\n  .banner-badge {\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n    font-size: 11px;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 2px;\n    color: #D98880;\n    margin-bottom: 4px;\n  }\n\n  .collection-main-title {\n    font-family: \"Playfair Display\", Georgia, serif;\n    font-size: 32px;\n    font-weight: 700;\n    color: #111111;\n    margin: 0;\n    line-height: 1.15;\n  }\n\n  @media (max-width: 768px) {\n    .custom-collection-banner-wrapper {\n      padding: 16px 16px;\n    }\n\n    .banner-badge {\n      font-size: 10px;\n    }\n\n    .collection-main-title {\n      font-size: 24px;\n    }\n  }\n</style>",
