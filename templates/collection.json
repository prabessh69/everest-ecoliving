    "custom_liquid_zgJRDU": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<style>\n  /* 1. Base hidden state for the product cards */\n  .custom-pop-product-card {\n    opacity: 0 !important;\n    transform: translateY(40px) scale(0.9) !important;\n    transition: opacity 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275), \n                transform 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;\n  }\n\n  /* 2. Active state when scrolled into view */\n  .custom-pop-product-card.is-visible {\n    opacity: 1 !important;\n    transform: translateY(0) scale(1) !important;\n  }\n\n  /* 3. Hover pop */\n  .custom-pop-product-card.is-visible:hover {\n    transform: translateY(-6px) scale(1.02) !important;\n    transition-delay: 0s !important;\n  }\n</style>\n\n<script>\n  (function() {\n    function initProductGridScrollAnim() {\n      // 1. Find the specific product images using the class you provided\n      const productImages = document.querySelectorAll('.product-media__image');\n      if (productImages.length === 0) return;\n\n      const targetCards = [];\n\n      // 2. Step backwards to find the main container (usually an <li>) that holds the image, title, and price\n      productImages.forEach(img => {\n        const cardBox = img.closest('li, .card-wrapper, .product-card-wrapper');\n        \n        if (cardBox && !cardBox.classList.contains('custom-pop-product-card')) {\n          cardBox.classList.add('custom-pop-product-card');\n          targetCards.push(cardBox);\n        }\n      });\n\n      // 3. Set up the scroll observer\n      const observerOptions = {\n        root: null,\n        rootMargin: '0px 0px -5% 0px', \n        threshold: 0.1\n      };\n\n      const cardObserver = new IntersectionObserver((entries) => {\n        entries.forEach(entry => {\n          if (entry.isIntersecting) {\n            entry.target.classList.add('is-visible');\n          } else {\n            entry.target.classList.remove('is-visible');\n          }\n        });\n      }, observerOptions);\n\n      // 4. Run the animation on the discovered product cards\n      targetCards.forEach(card => cardObserver.observe(card));\n    }\n\n    // Run immediately and safely hook into Shopify's loading events\n    initProductGridScrollAnim();\n    document.addEventListener('DOMContentLoaded', initProductGridScrollAnim);\n    document.addEventListener('shopify:section:load', initProductGridScrollAnim);\n    setTimeout(initProductGridScrollAnim, 500); // Backup delay to ensure images loaded\n  })();\n</script>",
        "background_color": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
