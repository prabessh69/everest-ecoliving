{%- doc -%}
  Size, hanging & display details (product block).

  Reads ONLY verified data from product metafields — it never invents measurements.
  Create these definitions in Admin → Settings → Custom data → Products:

    custom.dimensions       Single line text   e.g. "Length 20 cm × Breadth 21 cm"
    custom.height           Dimension          (optional, structured)
    custom.width            Dimension          (optional, structured)
    custom.length           Dimension          (optional, structured)
    custom.hanging_details  Multi-line text    e.g. "Natural cotton loop, approx. 8 cm"
    custom.display_details  Multi-line text    e.g. "Stands freely on a shelf or mantel"

  When none are filled in, an optional honest fallback note is shown instead
  (or nothing at all, if the fallback is turned off).
{%- enddoc -%}

{%- liquid
  assign block_settings = block.settings
  assign product_resource = closest.product
  assign mf = product_resource.metafields.custom

  assign dimensions_text = mf.dimensions.value
  assign hanging = mf.hanging_details
  assign display = mf.display_details

  assign has_structured = false
  if mf.height != blank or mf.width != blank or mf.length != blank
    assign has_structured = true
  endif

  assign has_data = false
  if dimensions_text != blank or has_structured or hanging != blank or display != blank
    assign has_data = true
  endif
-%}

{%- if has_data or block_settings.show_fallback -%}
  <div
    class="felt-specs-wrap spacing-style"
    style="{% render 'spacing-style', settings: block_settings %}"
    {{ block.shopify_attributes }}
  >
  <div class="felt-specs">
    {%- if block_settings.heading != blank -%}
      <p class="felt-specs__heading">{{ block_settings.heading | escape }}</p>
    {%- endif -%}

    {%- if has_data -%}
      <dl class="felt-specs__list">
        {%- if dimensions_text != blank -%}
          <div class="felt-specs__row">
            <dt>{{ block_settings.label_size | escape }}</dt>
            <dd>{{ dimensions_text | escape }}</dd>
          </div>
        {%- endif -%}

        {%- if has_structured -%}
          {%- assign dims = 'height,width,length' | split: ',' -%}
          {%- for dim_key in dims -%}
            {%- assign dim = mf[dim_key] -%}
            {%- if dim != blank -%}
              <div class="felt-specs__row">
                <dt>
                  {%- case dim_key -%}
                    {%- when 'height' -%}
                      {{ block_settings.label_height | escape }}
                    {%- when 'width' -%}
                      {{ block_settings.label_width | escape }}
                    {%- else -%}
                      {{ block_settings.label_length | escape }}
                  {%- endcase -%}
                </dt>
                <dd>
                  {%- if dim.type == 'dimension' -%}
                    {%- assign dim_value = dim.value.value -%}
                    {%- assign dim_rounded = dim_value | round -%}
                    {%- if dim_value == dim_rounded -%}
                      {{ dim_rounded }}
                    {%- else -%}
                      {{ dim_value | round: 1 }}
                    {%- endif %}
                    {{ dim.value.unit | escape -}}
                  {%- else -%}
                    {{ dim.value | escape }}
                  {%- endif -%}
                </dd>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- if hanging != blank -%}
          <div class="felt-specs__row">
            <dt>{{ block_settings.label_hanging | escape }}</dt>
            <dd>{{ hanging.value | escape | newline_to_br }}</dd>
          </div>
        {%- endif -%}

        {%- if display != blank -%}
          <div class="felt-specs__row">
            <dt>{{ block_settings.label_display | escape }}</dt>
            <dd>{{ display.value | escape | newline_to_br }}</dd>
          </div>
        {%- endif -%}
      </dl>

      {%- if block_settings.handmade_note != blank -%}
        <p class="felt-specs__note">{{ block_settings.handmade_note | escape }}</p>
      {%- endif -%}
    {%- else -%}
      <p class="felt-specs__note felt-specs__note--fallback">
        {{ block_settings.fallback_text | escape }}
        {%- if block_settings.fallback_link != blank and block_settings.fallback_link_label != blank %}
          <a href="{{ block_settings.fallback_link }}">{{ block_settings.fallback_link_label | escape }}</a>
        {%- endif -%}
      </p>
    {%- endif -%}
  </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .felt-specs-wrap {
    width: 100%;
  }

  .felt-specs {
    --felt-specs-accent: #58182d;
    --felt-specs-surface: rgb(255 242 245 / 0.7);
    --felt-specs-line: rgb(88 24 45 / 0.12);

    width: 100%;
    padding: 1rem 1.125rem;
    border: 1px solid var(--felt-specs-line);
    border-radius: 12px;
    background: var(--felt-specs-surface);
  }

  .felt-specs__heading {
    margin: 0 0 0.625rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--felt-specs-accent);
  }

  .felt-specs__list {
    display: grid;
    margin: 0;
  }

  .felt-specs__row {
    display: grid;
    grid-template-columns: minmax(6.5rem, 32%) 1fr;
    gap: 0.75rem;
    padding-block: 0.5rem;
    border-block-start: 1px solid var(--felt-specs-line);
  }

  .felt-specs__row:first-child {
    border-block-start: 0;
    padding-block-start: 0;
  }

  .felt-specs__row dt {
    font-weight: 600;
  }

  .felt-specs__row dd {
    margin: 0;
    line-height: 1.5;
  }

  .felt-specs__note {
    margin: 0.625rem 0 0;
    font-size: 0.875rem;
    line-height: 1.5;
    opacity: 0.8;
  }

  .felt-specs__note--fallback {
    margin: 0;
    opacity: 1;
  }

  .felt-specs__note a {
    color: var(--felt-specs-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media screen and (max-width: 749px) {
    .felt-specs__row {
      grid-template-columns: 1fr;
      gap: 0.125rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Size & display details",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows verified values from product metafields: custom.dimensions, custom.height, custom.width, custom.length, custom.hanging_details, custom.display_details."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Size & display"
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "label_size",
      "label": "Size label",
      "default": "Size"
    },
    {
      "type": "text",
      "id": "label_height",
      "label": "Height label",
      "default": "Height"
    },
    {
      "type": "text",
      "id": "label_width",
      "label": "Width label",
      "default": "Width"
    },
    {
      "type": "text",
      "id": "label_length",
      "label": "Length label",
      "default": "Length"
    },
    {
      "type": "text",
      "id": "label_hanging",
      "label": "Hanging label",
      "default": "Hanging"
    },
    {
      "type": "text",
      "id": "label_display",
      "label": "Display label",
      "default": "Display"
    },
    {
      "type": "text",
      "id": "handmade_note",
      "label": "Handmade note",
      "info": "Shown under the measurements.",
      "default": "Each piece is shaped by hand, so allow for slight natural variation."
    },
    {
      "type": "header",
      "content": "When no details are entered"
    },
    {
      "type": "checkbox",
      "id": "show_fallback",
      "label": "Show fallback note",
      "default": true
    },
    {
      "type": "text",
      "id": "fallback_text",
      "label": "Fallback text",
      "default": "Each piece is shaped by hand, so sizes vary slightly. For exact measurements,"
    },
    {
      "type": "url",
      "id": "fallback_link",
      "label": "Fallback link",
      "default": "/pages/contact"
    },
    {
      "type": "text",
      "id": "fallback_link_label",
      "label": "Fallback link label",
      "default": "just ask us."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Size & display details",
      "category": "Product"
    }
  ]
}
{% endschema %}
