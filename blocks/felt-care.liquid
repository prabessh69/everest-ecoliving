{%- doc -%}
  Felt care guide (product block).

  A reusable, collapsible care panel for felted wool pieces — felt flowers, shelf
  sculptures and festive decorations. Copy is editable in the theme editor.

  Optional per-product note: product metafield `custom.care_notes`
  (multi-line text or rich text). When set it appears as "Notes for this piece".

  Self-contained: does not touch the product form, media gallery or Judge.me widgets.
{%- enddoc -%}

{%- liquid
  assign block_settings = block.settings
  assign product_resource = closest.product
  assign care_notes = product_resource.metafields.custom.care_notes
-%}

<details
  class="felt-info felt-info--care spacing-style"
  style="{% render 'spacing-style', settings: block_settings %}"
  {% if block_settings.open_by_default %}
    open
  {% endif %}
  {{ block.shopify_attributes }}
>
  <summary class="felt-info__summary">
    <span class="felt-info__icon" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c-4.4-2.6-8-6.1-8-10.2A4.8 4.8 0 0 1 12 7.4a4.8 4.8 0 0 1 8 3.4c0 4.1-3.6 7.6-8 10.2Z"/></svg>
    </span>
    <span class="felt-info__title">{{ block_settings.heading | escape }}</span>
    <span class="felt-info__caret" aria-hidden="true">{{ 'icon-caret.svg' | inline_asset_content }}</span>
  </summary>

  <div class="felt-info__body">
    {%- if block_settings.intro != blank -%}
      <div class="felt-info__intro rte">{{ block_settings.intro }}</div>
    {%- endif -%}

    <ul class="felt-info__list" role="list">
      {%- if block_settings.care_dust != blank -%}
        <li>
          <span class="felt-info__label">{{ block_settings.care_dust_label | escape }}</span>
          <div class="rte">{{ block_settings.care_dust }}</div>
        </li>
      {%- endif -%}
      {%- if block_settings.care_spot != blank -%}
        <li>
          <span class="felt-info__label">{{ block_settings.care_spot_label | escape }}</span>
          <div class="rte">{{ block_settings.care_spot }}</div>
        </li>
      {%- endif -%}
      {%- if block_settings.care_display != blank -%}
        <li>
          <span class="felt-info__label">{{ block_settings.care_display_label | escape }}</span>
          <div class="rte">{{ block_settings.care_display }}</div>
        </li>
      {%- endif -%}
      {%- if block_settings.care_storage != blank -%}
        <li>
          <span class="felt-info__label">{{ block_settings.care_storage_label | escape }}</span>
          <div class="rte">{{ block_settings.care_storage }}</div>
        </li>
      {%- endif -%}
    </ul>

    {%- if care_notes != blank -%}
      <div class="felt-info__note">
        <span class="felt-info__label">{{ block_settings.notes_label | escape }}</span>
        <div class="rte">
          {%- if care_notes.type == 'rich_text_field' -%}
            {{ care_notes | metafield_tag }}
          {%- else -%}
            <p>{{ care_notes.value | escape | newline_to_br }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if block_settings.guide_link != blank and block_settings.guide_link_label != blank -%}
      <a
        class="felt-info__link"
        href="{{ block_settings.guide_link }}"
      >
        {{- block_settings.guide_link_label | escape -}}
      </a>
    {%- endif -%}
  </div>
</details>

{% stylesheet %}
  .felt-info {
    --felt-info-accent: var(--everest-plum, #58182d);
    --felt-info-icon: var(--everest-gum, #4f6b5a);
    --felt-info-surface: var(--everest-blush, #fff2f5);
    --felt-info-line: rgb(88 24 45 / 0.14);

    width: 100%;
    border-block: 1px solid var(--felt-info-line);
  }

  .felt-info + .felt-info {
    border-block-start: 0;
  }

  .felt-info__summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block: 1rem;
    cursor: pointer;
    list-style: none;
  }

  .felt-info__summary::-webkit-details-marker {
    display: none;
  }

  .felt-info__summary:focus-visible {
    outline: 2px solid var(--felt-info-accent);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .felt-info__icon {
    display: inline-flex;
    color: var(--felt-info-icon);
    flex: none;
  }

  .felt-info__title {
    flex: 1 1 auto;
    font-family: var(--font-heading--family);
    font-size: 1.125rem;
    font-weight: var(--font-heading--weight, 400);
    line-height: 1.2;
    color: var(--felt-info-accent);
  }

  .felt-info__caret {
    display: inline-flex;
    width: 0.75rem;
    transition: transform 0.25s ease;
  }

  .felt-info[open] .felt-info__caret {
    transform: rotate(180deg);
  }

  .felt-info__body {
    display: grid;
    gap: 1rem;
    padding-block-end: 1.25rem;
    line-height: 1.6;
  }

  .felt-info__body .rte > :first-child {
    margin-block-start: 0;
  }

  .felt-info__body .rte > :last-child {
    margin-block-end: 0;
  }

  .felt-info__list {
    display: grid;
    gap: 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .felt-info__list li {
    padding-inline-start: 0.875rem;
    border-inline-start: 2px solid var(--felt-info-line);
  }

  .felt-info__label {
    display: block;
    margin-block-end: 0.2rem;
    font-weight: 500;
    color: var(--felt-info-accent);
  }

  .felt-info__note {
    padding: 0.875rem 1rem;
    border-radius: 10px;
    background: var(--felt-info-surface);
  }

  .felt-info__link {
    justify-self: start;
    color: var(--felt-info-accent);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
  }

  .felt-info__link:hover {
    text-decoration-thickness: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .felt-info__caret {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Felt care guide",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Optional: add a product metafield custom.care_notes (multi-line text) for piece-specific notes."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Caring for your felt"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open by default",
      "default": false
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Felted wool is naturally hard-wearing and dirt-resistant. A little gentle care keeps every handmade piece looking its best for years.</p>"
    },
    {
      "type": "header",
      "content": "Care steps"
    },
    {
      "type": "text",
      "id": "care_dust_label",
      "label": "Step 1 label",
      "default": "Gentle dusting"
    },
    {
      "type": "richtext",
      "id": "care_dust",
      "label": "Step 1 text",
      "default": "<p>Brush lightly with a soft, dry brush or a lint roller. For felt flowers, gently fluff the petals back into shape with your fingers.</p>"
    },
    {
      "type": "text",
      "id": "care_spot_label",
      "label": "Step 2 label",
      "default": "Spot care only"
    },
    {
      "type": "richtext",
      "id": "care_spot",
      "label": "Step 2 text",
      "default": "<p>Dab marks with a cloth dampened in cool water and a little mild wool wash. Blot, don't rub. Avoid soaking, machine washing, wringing or harsh scrubbing, which can distort the felt. Leave to air-dry naturally, away from direct heat.</p>"
    },
    {
      "type": "text",
      "id": "care_display_label",
      "label": "Step 3 label",
      "default": "Display"
    },
    {
      "type": "richtext",
      "id": "care_display",
      "label": "Step 3 text",
      "default": "<p>Display shelf sculptures and flowers out of strong direct sunlight to help colours stay rich. Felt flowers never need water.</p>"
    },
    {
      "type": "text",
      "id": "care_storage_label",
      "label": "Step 4 label",
      "default": "Breathable storage"
    },
    {
      "type": "richtext",
      "id": "care_storage",
      "label": "Step 4 text",
      "default": "<p>Between seasons, wrap festive pieces in tissue paper and keep them in a cotton bag or cardboard box in a cool, dry place. Skip plastic, which traps moisture. A sprig of lavender or cedar helps keep moths away.</p>"
    },
    {
      "type": "header",
      "content": "Product notes & link"
    },
    {
      "type": "text",
      "id": "notes_label",
      "label": "Product notes label",
      "default": "Notes for this piece"
    },
    {
      "type": "url",
      "id": "guide_link",
      "label": "Care guide link",
      "info": "Point this to your published care guide page."
    },
    {
      "type": "text",
      "id": "guide_link_label",
      "label": "Link label",
      "default": "Read the full care guide"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Felt care guide",
      "category": "Product"
    }
  ]
}
{% endschema %}
